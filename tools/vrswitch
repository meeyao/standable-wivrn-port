#!/usr/bin/env bash
# vrswitch - switch between WiVRn and SteamVR (OpenXR + OpenVR runtimes)
#
#   vrswitch wivrn     point OpenXR/OpenVR at WiVRn (xrizer), start the WiVRn service
#   vrswitch steamvr   stop WiVRn, point OpenXR/OpenVR at SteamVR, launch SteamVR
#   vrswitch status    show which runtime is active (default)
set -euo pipefail

RUNTIME_LINK="$HOME/.config/openxr/1/active_runtime.json"
WIVRN_MANIFEST="/usr/share/openxr/1/openxr_wivrn.json"
STEAMVR_DIR="$HOME/.local/share/Steam/steamapps/common/SteamVR"
STEAMVR_MANIFEST="$STEAMVR_DIR/steamxr_linux64.json"
OPENVR_PATHS="$HOME/.config/openvr/openvrpaths.vrpath"
# xrizer lives in different places per packaging: AUR/release use /opt/xrizer,
# the Fedora @xr-sig COPR uses /usr/lib64/xrizer/runtime.
find_xrizer() {
  local d
  for d in /opt/xrizer /usr/lib64/xrizer/runtime /usr/lib/xrizer/runtime; do
    [ -f "$d/bin/linux64/vrclient.so" ] && { echo "$d"; return 0; }
  done
  return 1
}
XRIZER_DIR="$(find_xrizer || true)"
STEAMVR_APPID="250820"

die() { echo "error: $*" >&2; exit 1; }

# Point the OpenXR active runtime at a manifest. The loader dir does not exist
# on a fresh machine, and `ln` under `set -e` would abort the whole switch.
link_runtime() {
  mkdir -p "$(dirname "$RUNTIME_LINK")"
  ln -sfn "$1" "$RUNTIME_LINK"
}

current() {
  local target
  target="$(readlink -f "$RUNTIME_LINK" 2>/dev/null || true)"
  case "$target" in
    "$(readlink -f "$WIVRN_MANIFEST")")   echo "wivrn" ;;
    "$(readlink -f "$STEAMVR_MANIFEST")") echo "steamvr" ;;
    "")                                   echo "unset" ;;
    *)                                    echo "unknown ($target)" ;;
  esac
}

current_openvr() {
  [ -f "$OPENVR_PATHS" ] || { echo "unset"; return; }
  python3 - "$OPENVR_PATHS" <<'PY' 2>/dev/null || echo "unknown"
import json,sys
print(json.load(open(sys.argv[1])).get("runtime",["?"])[0])
PY
}

# Point the global OpenVR runtime at a directory. xrizer owns it by default,
# which makes SteamVR's own binaries (vrmonitor/vrserver) load xrizer and crash.
set_openvr_runtime() {
  local dir="$1"
  [ -f "$OPENVR_PATHS" ] || return 0
  python3 - "$OPENVR_PATHS" "$dir" <<'PY'
import json,sys
p,d=sys.argv[1],sys.argv[2]
cfg=json.load(open(p))
cfg["runtime"]=[d]
json.dump(cfg,open(p,"w"),indent=1)
PY
}

stop_steamvr() {
  pkill -f "SteamVR/bin/linux64/vrmonitor" 2>/dev/null || true
  pkill -f "SteamVR/bin/linux64/vrserver"  2>/dev/null || true
  sleep 1
}

# Standable's ignition_server.exe survives its host runtime shutting down and
# then holds the bridge, so the other runtime's shim fails with "error 305".
# The repo's reap-ignition does this without touching a live session.
kill_ignition() {
  if command -v reap-ignition >/dev/null 2>&1; then
    reap-ignition --quiet --kill || true
  else
    pkill -x ignition_server 2>/dev/null || true
  fi
  sleep 1
}

# The Standable launcher and Proton rewrite openvrpaths.vrpath and can drop the
# host reaction_drivers list, which makes SteamVR silently skip the drivers.
# Re-add the ones that are installed before every SteamVR switch.
ensure_external_drivers() {
  [ -f "$OPENVR_PATHS" ] || return 0
  local common="$HOME/.local/share/Steam/steamapps/common"
  local d
  for d in SlimeVR "Standable Full Body Estimation"; do
    [ -f "$common/$d/driver.vrdrivermanifest" ] && printf '%s\n' "$common/$d"
  done | python3 - "$OPENVR_PATHS" <<'PY'
import json, sys
p = sys.argv[1]
want = [l.strip() for l in sys.stdin if l.strip()]
d = json.load(open(p))
cur = [x for x in (d.get("external_drivers") or []) if not x.startswith("S:\\\\")]
merged = want + [x for x in cur if x not in want]
if merged != (d.get("external_drivers") or []):
    d["external_drivers"] = merged
    json.dump(d, open(p, "w"), indent=2)
    print("external_drivers restored:", merged)
PY
}

# SteamVR latches safe mode in two places outside our repos: the crash-timestamp
# file (any unclean vrserver exit rewrites it) and blocked_by_safe_mode flags
# per driver. The settings UI clears neither, so without this every crash stuck
# around forever and each manual clear was undone by the next crash.
clear_safe_mode_latch() {
  if pgrep -f "SteamVR/bin/linux64/vrserver" >/dev/null 2>&1; then
    echo "warning: vrserver running, skipping safe-mode clear (would be overwritten)" >&2
    return 0
  fi
  rm -f "$HOME/.local/share/Steam/config/vrserver_crash_timestamp.txt"
  python3 - <<'PY'
import json, os
p = os.path.expanduser("~/.local/share/Steam/config/steamvr.vrsettings")
try:
    d = json.load(open(p))
except Exception as e:
    print(f"warning: cannot read vrsettings: {e}")
    raise SystemExit
cleared = [k for k, v in d.items()
           if isinstance(v, dict) and v.pop("blocked_by_safe_mode", None) is not None]
if cleared:
    json.dump(d, open(p, "w"), indent=1)
    print("safe-mode latch cleared:", ", ".join(cleared))
else:
    print("safe-mode latch: already clear")
PY
}

start_steamvr() {
  command -v steam >/dev/null 2>&1 || die "steam command not found"
  nohup steam "steam://rungameid/$STEAMVR_APPID" >/dev/null 2>&1 &
}

case "${1:-status}" in
  wivrn|w)
    [ -n "$XRIZER_DIR" ] || die "xrizer runtime not found (looked in /opt/xrizer and /usr/lib64/xrizer/runtime); install xrizer (Fedora: dnf copr enable @xr-sig/xrizer && dnf install xrizer) or re-run ./install.sh"
    # Set the runtime first: if a cleanup step stalls, the critical state is
    # already correct instead of half-switched.
    link_runtime "$WIVRN_MANIFEST"
    set_openvr_runtime "$XRIZER_DIR"
    systemctl --user reset-failed wivrn.service 2>/dev/null || true
    stop_steamvr
    kill_ignition
    systemctl --user start wivrn.service
    echo "OpenXR -> WiVRn, OpenVR -> xrizer (service started)"
    ;;
  steamvr|s|steam)
    # Runtime + drivers first (critical), cleanup last (best-effort).
    ensure_external_drivers
    link_runtime "$STEAMVR_MANIFEST"
    set_openvr_runtime "$STEAMVR_DIR"
    systemctl --user stop wivrn.service 2>/dev/null || true
    pkill -x wivrn-server 2>/dev/null || true
    systemctl --user reset-failed wivrn.service 2>/dev/null || true
    kill_ignition
    clear_safe_mode_latch
    start_steamvr
    echo "OpenXR -> SteamVR, OpenVR -> SteamVR (launching)"
    ;;
  status|st|"")
    echo "OpenXR runtime: $(current)"
    ovr="$(current_openvr)"
    if [ "$ovr" != "unset" ] && [ ! -f "$ovr/bin/linux64/vrclient.so" ]; then
      ovr="$ovr (missing)"
    fi
    echo "OpenVR runtime: $ovr"
    printf "WiVRn service:  %s\n" "$(systemctl --user show -p ActiveState --value wivrn.service 2>/dev/null)"
    if pgrep -f "SteamVR/bin/linux64/vrmonitor" >/dev/null 2>&1; then
      echo "SteamVR:        running"
    else
      echo "SteamVR:        not running"
    fi
    ;;
  -h|--help|help)
    sed -n '2,6p' "$0" | sed 's/^# \{0,1\}//'
    ;;
  *)
    echo "usage: vrswitch [wivrn|steamvr|status]" >&2
    exit 2
    ;;
esac
