+#pragma once
+
+#include "xrt/xrt_device.h"
+
+namespace wivrn
+{
+class standable_body_tracker : public xrt_device
+{
+	// The 8 Standable proxy devices (from steamvr_lh), matched by serial.
+	xrt_device * hip;
+	xrt_device * chest;
+	xrt_device * elbow_left;
+	xrt_device * elbow_right;
+	xrt_device * knee_left;
+	xrt_device * knee_right;
+	xrt_device * foot_left;
+	xrt_device * foot_right;
+
+	static xrt_result_t body_joints(struct xrt_device * xdev,
+	                                enum xrt_input_name body_tracking_type,
+	                                int64_t desired_timestamp_ns,
+	                                struct xrt_body_joint_set * out_value);
+	static xrt_result_t update_inputs(struct xrt_device * xdev);
+	static void destroy(struct xrt_device * xdev);
+
+public:
+	standable_body_tracker(xrt_device * hip,
+	                       xrt_device * chest,
+	                       xrt_device * elbow_left,
+	                       xrt_device * elbow_right,
+	                       xrt_device * knee_left,
+	                       xrt_device * knee_right,
+	                       xrt_device * foot_left,
+	                       xrt_device * foot_right);
+	~standable_body_tracker();
+
+	static xrt_device * create(xrt_device * hip,
+	                           xrt_device * chest,
+	                           xrt_device * elbow_left,
+	                           xrt_device * elbow_right,
+	                           xrt_device * knee_left,
+	                           xrt_device * knee_right,
+	                           xrt_device * foot_left,
+	                           xrt_device * foot_right);
+};
+} // namespace wivrn
