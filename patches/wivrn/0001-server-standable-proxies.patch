diff --git a/server/driver/wivrn_standable_body_tracker.cpp b/server/driver/wivrn_standable_body_tracker.cpp
new file mode 100644
index 00000000..bb9aba6e
--- /dev/null
+++ b/server/driver/wivrn_standable_body_tracker.cpp
@@ -0,0 +1,178 @@
+#include "wivrn_standable_body_tracker.h"
+
+#include "util/u_device_id.h"
+#include "xrt/xrt_defines.h"
+
+#include <cstring>
+
+namespace wivrn
+{
+namespace
+{
+xrt_result_t
+read_proxy_pose(struct xrt_device * proxy, int64_t at_timestamp_ns, struct xrt_space_relation * out_relation)
+{
+	if (proxy == nullptr || proxy->get_tracked_pose == nullptr)
+	{
+		return XRT_ERROR_POSE_NOT_ACTIVE;
+	}
+	return proxy->get_tracked_pose(proxy, XRT_INPUT_GENERIC_TRACKER_POSE, at_timestamp_ns, out_relation);
+}
+} // namespace
+
+xrt_result_t
+standable_body_tracker::body_joints(struct xrt_device * xdev,
+                                    enum xrt_input_name body_tracking_type,
+                                    int64_t desired_timestamp_ns,
+                                    struct xrt_body_joint_set * out_value)
+{
+	auto * self = static_cast<standable_body_tracker *>(xdev);
+
+	struct xrt_body_joint_location_fb * fb_joints = nullptr;
+	uint32_t fb_count = 0;
+	struct xrt_body_joint_location_fb * meta_joints = nullptr;
+	uint32_t meta_count = 0;
+
+	switch (body_tracking_type)
+	{
+		case XRT_INPUT_FB_BODY_TRACKING:
+			fb_joints = out_value->body_joint_set_fb.joint_locations;
+			fb_count = ARRAY_SIZE(out_value->body_joint_set_fb.joint_locations);
+			break;
+		case XRT_INPUT_META_FULL_BODY_TRACKING:
+			meta_joints = out_value->full_body_joint_set_meta.joint_locations;
+			meta_count = ARRAY_SIZE(out_value->full_body_joint_set_meta.joint_locations);
+			break;
+		default:
+			return XRT_ERROR_NOT_IMPLEMENTED;
+	}
+
+	out_value->base_body_joint_set_meta.sample_time_ns = desired_timestamp_ns;
+	out_value->base_body_joint_set_meta.confidence = 0.f;
+	out_value->base_body_joint_set_meta.skeleton_changed_count = 1;
+	out_value->base_body_joint_set_meta.is_active = false;
+	bool any_valid = false;
+
+	for (uint32_t i = 0; i < fb_count; ++i)
+	{
+		fb_joints[i].relation = xrt_space_relation{};
+	}
+	for (uint32_t i = 0; i < meta_count; ++i)
+	{
+		meta_joints[i].relation = xrt_space_relation{};
+	}
+
+	const struct
+	{
+		xrt_device * proxy;
+		uint32_t fb_index;
+		uint32_t meta_index;
+	} joints[] = {
+	        {self->hip, XRT_BODY_JOINT_HIPS_FB, XRT_FULL_BODY_JOINT_HIPS_META},
+	        {self->chest, XRT_BODY_JOINT_CHEST_FB, XRT_FULL_BODY_JOINT_CHEST_META},
+	        {self->elbow_left, XRT_BODY_JOINT_LEFT_ARM_LOWER_FB, XRT_FULL_BODY_JOINT_LEFT_ARM_LOWER_META},
+	        {self->elbow_right, XRT_BODY_JOINT_RIGHT_ARM_LOWER_FB, XRT_FULL_BODY_JOINT_RIGHT_ARM_LOWER_META},
+	        {self->knee_left, 0, XRT_FULL_BODY_JOINT_LEFT_LOWER_LEG_META},
+	        {self->knee_right, 0, XRT_FULL_BODY_JOINT_RIGHT_LOWER_LEG_META},
+	        {self->foot_left, 0, XRT_FULL_BODY_JOINT_LEFT_FOOT_TRANSVERSE_META},
+	        {self->foot_right, 0, XRT_FULL_BODY_JOINT_RIGHT_FOOT_TRANSVERSE_META},
+	};
+
+	for (const auto & j: joints)
+	{
+		if (j.proxy == nullptr)
+		{
+			continue;
+		}
+		struct xrt_space_relation relation = xrt_space_relation{};
+		if (read_proxy_pose(j.proxy, desired_timestamp_ns, &relation) != XRT_SUCCESS)
+		{
+			continue;
+		}
+		if ((relation.relation_flags & XRT_SPACE_RELATION_ORIENTATION_VALID_BIT) == 0)
+		{
+			continue;
+		}
+		any_valid = true;
+		if (fb_joints != nullptr && j.fb_index != 0 && j.fb_index < fb_count)
+		{
+			fb_joints[j.fb_index].relation = relation;
+		}
+		if (meta_joints != nullptr && j.meta_index != 0 && j.meta_index < meta_count)
+		{
+			meta_joints[j.meta_index].relation = relation;
+		}
+	}
+
+	out_value->base_body_joint_set_meta.confidence = any_valid ? 1.f : 0.f;
+	out_value->base_body_joint_set_meta.is_active = any_valid;
+	out_value->body_pose = xrt_space_relation{};
+	if (any_valid)
+	{
+		out_value->body_pose = xrt_space_relation{
+		        .relation_flags = (xrt_space_relation_flags)(XRT_SPACE_RELATION_ORIENTATION_VALID_BIT | XRT_SPACE_RELATION_POSITION_VALID_BIT |
+		                                                     XRT_SPACE_RELATION_ORIENTATION_TRACKED_BIT | XRT_SPACE_RELATION_POSITION_TRACKED_BIT),
+		        .pose = XRT_POSE_IDENTITY,
+		};
+	}
+
+	return XRT_SUCCESS;
+}
+
+void standable_body_tracker::destroy(struct xrt_device * xdev)
+{
+	delete static_cast<standable_body_tracker *>(xdev);
+}
+
+xrt_result_t
+standable_body_tracker::update_inputs(struct xrt_device * xdev)
+{
+	return XRT_SUCCESS;
+}
+
+standable_body_tracker::standable_body_tracker(xrt_device * hip,
+                                               xrt_device * chest,
+                                               xrt_device * elbow_left,
+                                               xrt_device * elbow_right,
+                                               xrt_device * knee_left,
+                                               xrt_device * knee_right,
+                                               xrt_device * foot_left,
+                                               xrt_device * foot_right) :
+        xrt_device{
+                .id = u_device_id_generate(),
+                .name = XRT_DEVICE_VIVE_TRACKER,
+                .device_type = XRT_DEVICE_TYPE_BODY_TRACKER,
+                .tracking_origin = hip != nullptr ? hip->tracking_origin : (elbow_left != nullptr ? elbow_left->tracking_origin : nullptr),
+                .supported = {.orientation_tracking = true, .position_tracking = true},
+                .update_inputs = &standable_body_tracker::update_inputs,
+                .get_body_joints = &standable_body_tracker::body_joints,
+                .destroy = &standable_body_tracker::destroy,
+        },
+        hip(hip),
+        chest(chest),
+        elbow_left(elbow_left),
+        elbow_right(elbow_right),
+        knee_left(knee_left),
+        knee_right(knee_right),
+        foot_left(foot_left),
+        foot_right(foot_right)
+{
+	strlcpy(str, "WiVRn Standable body tracker", sizeof(str));
+	strlcpy(serial, "wivrn-standable-body", sizeof(serial));
+}
+
+standable_body_tracker::~standable_body_tracker() = default;
+
+xrt_device *
+standable_body_tracker::create(xrt_device * hip,
+                               xrt_device * chest,
+                               xrt_device * elbow_left,
+                               xrt_device * elbow_right,
+                               xrt_device * knee_left,
+                               xrt_device * knee_right,
+                               xrt_device * foot_left,
+                               xrt_device * foot_right)
+{
+	return new standable_body_tracker(hip, chest, elbow_left, elbow_right, knee_left, knee_right, foot_left, foot_right);
+}
+} // namespace wivrn
