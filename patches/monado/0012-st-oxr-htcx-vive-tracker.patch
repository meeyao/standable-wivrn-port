+//! OpenXR API function @ep{xrEnumerateViveTrackerPathsHTCX}
+XRAPI_ATTR XrResult XRAPI_CALL
+oxr_xrEnumerateViveTrackerPathsHTCX(XrInstance instance,
+                                    uint32_t pathCapacityInput,
+                                    uint32_t *pathCountOutput,
+                                    XrViveTrackerPathsHTCX *paths);
+
 
 /*
  *
diff --git a/src/xrt/state_trackers/oxr/oxr_api_instance.c b/src/xrt/state_trackers/oxr/oxr_api_instance.c
index 712344bd5..8f5d82768 100644
--- a/src/xrt/state_trackers/oxr/oxr_api_instance.c
+++ b/src/xrt/state_trackers/oxr/oxr_api_instance.c
@@ -520,3 +520,73 @@ oxr_xrConvertTimeToWin32PerformanceCounterKHR(XrInstance instance, XrTime time,
 }
 
 #endif // XR_USE_PLATFORM_WIN32
+
+XRAPI_ATTR XrResult XRAPI_CALL
+oxr_xrEnumerateViveTrackerPathsHTCX(XrInstance instance,
+                                    uint32_t pathCapacityInput,
+                                    uint32_t *pathCountOutput,
+                                    XrViveTrackerPathsHTCX *paths)
+{
+	OXR_TRACE_MARKER();
+
+	struct oxr_instance *inst;
+	struct oxr_logger log;
+	OXR_VERIFY_INSTANCE_AND_INIT_LOG(&log, instance, inst, "xrEnumerateViveTrackerPathsHTCX");
+
+	struct oxr_system *sys = &inst->system;
+	uint32_t count = 0;
+	if (sys->xsysd != NULL) {
+		struct xrt_system_roles roles = {0};
+		xrt_result_t xret = xrt_system_devices_get_roles(sys->xsysd, &roles);
+		if (xret != XRT_SUCCESS) {
+			return oxr_error(&log, XR_ERROR_RUNTIME_FAILURE, "Failed to get device roles");
+		}
+
+		const struct { int32_t idx; const char *role_path; } trackers[] = {
+		    {roles.waist, "/user/vive_tracker_htcx/role/waist"},
+		    {roles.chest, "/user/vive_tracker_htcx/role/chest"},
+		    {roles.left_foot, "/user/vive_tracker_htcx/role/left_foot"},
+		    {roles.right_foot, "/user/vive_tracker_htcx/role/right_foot"},
+		    {roles.left_knee, "/user/vive_tracker_htcx/role/left_knee"},
+		    {roles.right_knee, "/user/vive_tracker_htcx/role/right_knee"},
+		    {roles.left_elbow, "/user/vive_tracker_htcx/role/left_elbow"},
+		    {roles.right_elbow, "/user/vive_tracker_htcx/role/right_elbow"},
+		};
+
+		for (size_t i = 0; i < ARRAY_SIZE(trackers); i++) {
+			if (trackers[i].idx >= 0) {
+				count++;
+			}
+		}
+
+		if (paths != NULL) {
+			uint32_t filled = 0;
+			for (size_t i = 0; i < ARRAY_SIZE(trackers) && filled < pathCapacityInput; i++) {
+				if (trackers[i].idx < 0) {
+					continue;
+				}
+				struct xrt_device *xdev = sys->xsysd->static_xdevs[trackers[i].idx];
+				XrPath role_path = XR_NULL_PATH;
+				oxr_path_store_get_or_create(&inst->path_store, trackers[i].role_path,
+				                             strlen(trackers[i].role_path), &role_path);
+
+				char persistent[XR_MAX_PATH_LENGTH];
+				snprintf(persistent, sizeof(persistent), "/user/vive_tracker_htcx/%s", xdev->serial);
+				XrPath persistent_path = XR_NULL_PATH;
+				oxr_path_store_get_or_create(&inst->path_store, persistent, strlen(persistent), &persistent_path);
+
+				paths[filled].type = XR_TYPE_VIVE_TRACKER_PATHS_HTCX;
+				paths[filled].next = NULL;
+				paths[filled].persistentPath = persistent_path;
+				paths[filled].rolePath = role_path;
+				filled++;
+			}
+		}
+	}
+
+	if (pathCountOutput != NULL) {
+		*pathCountOutput = count;
+	}
+
+	return XR_SUCCESS;
+}
