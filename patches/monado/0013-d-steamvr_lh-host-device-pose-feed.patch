+static struct xrt_device *g_feed_head = nullptr;
+static struct xrt_device *g_feed_left = nullptr;
+static struct xrt_device *g_feed_right = nullptr;
+
+static void
+set_device_property(Device *dev, vr::ETrackedDeviceProperty prop, vr::PropertyTypeTag_t tag, const void *data, uint32_t size)
+{
+	vr::PropertyWrite_t w{};
+	w.prop = prop;
+	w.writeType = vr::EPropertyWriteType::PropertyWrite_Set;
+	w.unTag = tag;
+	w.pvBuffer = const_cast<void *>(data);
+	w.unBufferSize = size;
+	dev->handle_properties(&w, 1);
+}
+
+static void
+set_device_string(Device *dev, vr::ETrackedDeviceProperty prop, const char *value)
+{
+	set_device_property(dev, prop, vr::k_unStringPropertyTag, value, (uint32_t)strlen(value) + 1);
+}
+
+/*!
+ * Populate the OpenVR device list with a virtual HMD at index 0 and virtual
+ * controllers at indices 1/2. Body-estimation drivers such as Standable look
+ * up the headset/controllers by Prop_DeviceClass_Int32; without these they see
+ * no headset and their own trackers take the low indices, so they can never
+ * estimate. Runs before the hosted driver adds its own devices so those land
+ * at index 3 and up. These devices are intentionally kept out of the WiVRn
+ * device list.
+ */
+static void
+create_steamvr_side_devices(const std::shared_ptr<Context> &ctx)
+{
+	if (ctx == nullptr)
+		return;
+
+	if (ctx->hmd == nullptr) {
+		auto *vhmd = new HmdDevice(DeviceBuilder{ctx, nullptr, "wivrn-hmd", STEAM_INSTALL_DIR});
+		int32_t dev_class = vr::TrackedDeviceClass_HMD;
+		set_device_property(vhmd, vr::Prop_DeviceClass_Int32, vr::k_unInt32PropertyTag, &dev_class, sizeof(dev_class));
+		set_device_string(vhmd, vr::Prop_TrackingSystemName_String, "wivrn");
+		set_device_string(vhmd, vr::Prop_ModelNumber_String, "WiVRn HMD");
+		set_device_string(vhmd, vr::Prop_SerialNumber_String, "wivrn-hmd-0");
+		set_device_string(vhmd, vr::Prop_ManufacturerName_String, "WiVRn");
+		set_device_string(vhmd, vr::Prop_RenderModelName_String, "generic_hmd");
+		bool false_val = false;
+		set_device_property(vhmd, vr::Prop_DeviceIsWireless_Bool, vr::k_unBoolPropertyTag, &false_val,
+		                    sizeof(false_val));
+		ctx->hmd = vhmd;
+		ctx->virtual_head = vhmd;
+	}
+
+	struct VirtualController
+	{
+		struct xrt_device *feed;
+		Device **slot;
+		size_t index;
+		const char *serial;
+		const char *model;
+		int32_t role;
+		const char *ctype;
+	};
+	const VirtualController ctrls[] = {
+	    {g_feed_left, &ctx->virtual_left, 0, "wivrn-left", "WiVRn Left Controller",
+	     vr::TrackedControllerRole_LeftHand, "oculus_touch"},
+	    {g_feed_right, &ctx->virtual_right, 1, "wivrn-right", "WiVRn Right Controller",
+	     vr::TrackedControllerRole_RightHand, "oculus_touch"},
+	};
+	for (const auto &c : ctrls) {
+		if (c.feed == nullptr || ctx->controller[c.index] != nullptr)
+			continue;
+		auto *vc = new ControllerDevice(c.index + 1, DeviceBuilder{ctx, nullptr, c.serial, STEAM_INSTALL_DIR});
+		int32_t dev_class = vr::TrackedDeviceClass_Controller;
+		set_device_property(vc, vr::Prop_DeviceClass_Int32, vr::k_unInt32PropertyTag, &dev_class, sizeof(dev_class));
+		int32_t role = c.role;
+		set_device_property(vc, vr::Prop_ControllerRoleHint_Int32, vr::k_unInt32PropertyTag, &role, sizeof(role));
+		set_device_string(vc, vr::Prop_TrackingSystemName_String, "wivrn");
+		set_device_string(vc, vr::Prop_ModelNumber_String, c.model);
+		set_device_string(vc, vr::Prop_SerialNumber_String, c.serial);
+		set_device_string(vc, vr::Prop_ManufacturerName_String, "WiVRn");
+		set_device_string(vc, vr::Prop_RenderModelName_String, "generic_controller");
+		set_device_string(vc, vr::Prop_ControllerType_String, c.ctype);
+		ctx->controller[c.index] = vc;
+		*c.slot = vc;
+	}
+}
